{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.pcitech.com/schemas/data-generator/writer-schema.json",
  "title": "数据生成模板-V2.1.0",
  "description": "数据生成模板-V2.1.0",
  "type": "object",
  "$defs": {
    "writer": {
      "$id": "#writer",
      "description": "数据写入器配置",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "写入器数据源类型",
          "enum": [
            "CONSOLE",
            "JDBC",
            "MYSQL",
            "POSTGRES",
            "CLICKHOUSE",
            "ELASTICSEARCH",
            "KAFKA"
          ]
        },
        "dataSourceId": {
          "type": "string",
          "description": "数据源编号：JDBC/ELASTICSEARCH/KAFKA这三种模式下不能为空，并且与对应初始化的数据源编号一一对应"
        },
        "target": {
          "type": "string",
          "description": "数据源表名/索引名/主题名"
        },
        "template": {
          "type": "string",
          "minLength": 1,
          "description": "数据写入模板：（1）JDBC->通常是insert into语句；（2）ElasticSearch/Kafka->通常是json语句；"
        }
      },
      "required": [
        "type"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.pcitech.com/schemas/data-generator/template-schema.json",
  "title": "数据生成模板-V2.1.0",
  "description": "数据生成模板-V2.1.0",
  "type": "object",
  "$defs": {
    "field": {
      "$id": "#field",
      "description": "字段配置",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "字段名",
          "minLength": 1,
          "maxLength": 128
        },
        "dependsOn": {
          "type": "array",
          "description": "依赖字段列表"
        },
        "stages": {
          "type": "array",
          "description": "字段的处理阶段列表",
          "minItems": 1,
          "uniqueItems": false,
          "items": {
            "$ref": "stage-schema.json/#/$defs/stage"
          }
        }
      },
      "required": [
        "name"
      ]
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "description": "模板名称",
      "minLength": 1,
      "maxLength": 256
    },
    "amount": {
      "type": "integer",
      "description": "生成总数量",
      "minimum": 1,
      "maximum": 1000000
    },
    "batchSize": {
      "type": "integer",
      "description": "每个批次提交（写入）数量",
      "minimum": 1,
      "maximum": 10000
    },
    "table": {
      "type": "object",
      "description": "数据集（表）元数据配置",
      "properties": {
        "fields": {
          "type": "array",
          "description": "字段配置列表",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#field"
          }
        }
      }
    },
    "output": {
      "type": "object",
      "description": "输出配置",
      "properties": {
        "writers": {
          "type": "array",
          "description": "数据写入器列表",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "writer-schema.json/#/$defs/writer"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "amount",
    "batchSize",
    "table",
    "output"
  ]
}

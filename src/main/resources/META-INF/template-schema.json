{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.pcitech.com/schemas/data-generator",
  "title": "数据生成模板-V2.0.0",
  "description": "数据生成模板-V2.0.0",
  "type": "object",
  "definitions": {
    "stage": {
      "$id": "#stage",
      "type": "object",
      "description": "阶段处理",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "阶段类型",
          "enum": [
            "READ",
            "SELECT",
            "SCRIPT",
            "CONVERT",
            "MAPPING",
            "WRITE"
          ]
        }
      },
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "READ"
            }
          },
          "$ref": "#readStage"
        },
        {
          "properties": {
            "type": {
              "const": "SELECT"
            }
          },
          "$ref": "#selectStage"
        },
        {
          "properties": {
            "type": {
              "const": "SCRIPT"
            }
          },
          "$ref": "#scriptStage"
        },
        {
          "properties": {
            "type": {
              "const": "CONVERT"
            }
          },
          "$ref": "#convertStage"
        },
        {
          "properties": {
            "type": {
              "const": "MAPPING"
            }
          },
          "$ref": "#mappingStage"
        },
        {
          "properties": {
            "type": {
              "const": "WRITE"
            }
          },
          "$ref": "#writer"
        }
      ]
    },
    "readStage": {
      "$id": "#readStage",
      "type": "object",
      "description": "数据读取阶段配置",
      "properties": {
        "dataSetId": {
          "type": "boolean",
          "description": "数据集编号，全模板唯一"
        },
        "inMemory": {
          "type": "boolean",
          "description": "数据是否驻留内存"
        },
        "params": {
          "type": "object",
          "description": "参数集合"
        },
        "strategyType": {
          "type": "object",
          "minLength": 1,
          "description": "选择策略",
          "enum": [
            "EQUAL",
            "WEIGHT"
          ]
        },
        "readers": {
          "type": "array",
          "minLength": 1,
          "description": "读取器列表",
          "items": {
            "$ref": "#reader"
          }
        },
        "required": [
          "readers"
        ]
      }
    },
    "selectStage": {
      "$id": "#selectStage",
      "type": "object",
      "description": "数据选择阶段配置",
      "properties": {
        "strategyType": {
          "type": "string",
          "minLength": 1,
          "description": "选择策略",
          "enum": [
            "REPEAT_RANDOM",
            "REPEAT_ORDER",
            "ONCE_RANDOM",
            "ONCE_ORDER",
            "MULTIPLE_ORDER"
          ]
        },
        "selectNum": {
          "type": "integer",
          "description": "选择数量"
        },
        "minTimes": {
          "type": "integer",
          "description": "最少选择次数"
        },
        "maxTimes": {
          "type": "integer",
          "minLength": 1,
          "description": "最多选择次数"
        }
      }
    },
    "scriptStage": {
      "$id": "#scriptStage",
      "type": "object",
      "description": "数据脚本处理阶段配置",
      "properties": {
        "scriptType": {
          "type": "string",
          "minLength": 1,
          "description": "脚本类型",
          "enum": [
            "JAVASCRIPT",
            "SPEL"
          ]
        },
        "content": {
          "type": "string",
          "description": "脚本内容"
        }
      }
    },
    "convertStage": {
      "$id": "#convertStage",
      "type": "object",
      "description": "数据转换处理阶段配置"
    },
    "mappingStage": {
      "$id": "#mappingStage",
      "type": "object",
      "description": "数据映射处理阶段配置"
    },
    "reader": {
      "$id": "#reader",
      "type": "object",
      "description": "数据读取器配置",
      "properties": {
        "weight": {
          "type": "integer",
          "description": "权重值"
        },
        "type": {
          "type": "string",
          "description": "数据集类型",
          "enum": [
            "JDBC",
            "ELASTICSEARCH",
            "KAFKA",
            "CONSTANT",
            "SPEL",
            "DIRECT_SPEL"
          ]
        },
        "dataSourceId": {
          "type": "string",
          "description": "数据源编号：JDBC/ELASTICSEARCH/KAFKA这三种模式下不能为空，并且与对应初始化的数据源编号一一对应"
        },
        "dataSet": {
          "type": [
            "array",
            "string",
            "integer"
          ],
          "description": "数据集，CONSTANT模式下必须为array类型值，其余模式则为字符串你类型值"
        }
      },
      "required": [
        "type",
        "dataSet"
      ]
    },
    "writer": {
      "$id": "#writer",
      "description": "数据写入器配置",
      "type": "object",
      "properties": {
        "type": {
          "writerType": "string",
          "description": "写入器数据源类型",
          "enum": [
            "JDBC",
            "MYSQL",
            "POSTGRES",
            "CLICKHOUSE",
            "ELASTICSEARCH",
            "KAFKA"
          ]
        },
        "dataSourceId": {
          "type": "string",
          "description": "数据源编号：JDBC/ELASTICSEARCH/KAFKA这三种模式下不能为空，并且与对应初始化的数据源编号一一对应"
        },
        "target": {
          "type": "string",
          "description": "数据源表名/索引名/主题名"
        },
        "template": {
          "type": "string",
          "minLength": 1,
          "description": "数据写入模板：（1）JDBC->通常是insert into语句；（2）ElasticSearch/Kafka->通常是json语句；"
        }
      },
      "required": [
        "writerType"
      ]
    },
    "field": {
      "$id": "#field",
      "description": "字段配置",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "字段名",
          "minLength": 1,
          "maxLength": 128
        },
        "dependsOn": {
          "type": "array",
          "description": "依赖字段列表"
        },
        "stages": {
          "type": "array",
          "description": "字段的处理阶段列表",
          "minItems": 1,
          "uniqueItems": false,
          "items": {
            "$ref": "#stage"
          }
        }
      },
      "required": [
        "name"
      ]
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "description": "模板名称",
      "minLength": 1,
      "maxLength": 256
    },
    "amount": {
      "type": "integer",
      "description": "生成总数量",
      "minimum": 1,
      "maximum": 1000000
    },
    "batchSize": {
      "type": "integer",
      "description": "每个批次提交（写入）数量",
      "minimum": 1,
      "maximum": 10000
    },
    "table": {
      "type": "object",
      "description": "数据集（表）元数据配置",
      "properties": {
        "fields": {
          "type": "array",
          "description": "字段配置列表",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#field"
          }
        },
        "writers": {
          "type": "array",
          "description": "数据写入器列表",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#writer"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "amount",
    "batchSize",
    "table"
  ]
}

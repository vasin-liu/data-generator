{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.pcitech.com/schemas/data-generator/reader-schema.json",
  "title": "数据生成模板-V2.1.0",
  "description": "数据生成模板-V2.1.0",
  "type": "object",
  "$defs": {
    "reader": {
      "$id": "#reader",
      "type": "object",
      "description": "数据读取器配置",
      "properties": {
        "weight": {
          "type": "integer",
          "description": "权重值",
          "default": 100
        },
        "type": {
          "type": "string",
          "description": "数据集类型",
          "enum": [
            "JDBC",
            "ELASTICSEARCH",
            "KAFKA",
            "CONSTANT",
            "SPEL",
            "AI"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "JDBC"
            }
          },
          "$ref": "#jdbcReader"
        },
        {
          "properties": {
            "type": {
              "const": "SPEL"
            }
          },
          "$ref": "#spelReader"
        },
        {
          "properties": {
            "type": {
              "const": "CONSTANT"
            }
          },
          "$ref": "#constantReader"
        },
        {
          "properties": {
            "type": {
              "const": "AI"
            }
          },
          "$ref": "#aiReader"
        }
      ],
      "required": [
        "type"
      ]
    },
    "jdbcReader": {
      "$id": "#jdbcReader",
      "type": "object",
      "description": "JDBC数据读取器配置",
      "properties": {
        "dataSourceId": {
          "type": "string",
          "description": "数据源ID"
        },
        "content": {
          "type": "string",
          "description": "SQL语句"
        }
      },
      "required": [
        "dataSourceId",
        "content"
      ]
    },
    "spelReader": {
      "$id": "#spelReader",
      "type": "object",
      "description": "SPEL数据读取器配置",
      "properties": {
        "content": {
          "type": "string",
          "description": "表达式字符串"
        },
        "times": {
          "type": "integer",
          "description": "表达式执行次数",
          "default": 1,
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "content"
      ]
    },
    "constantReader": {
      "$id": "#constantReader",
      "type": "object",
      "description": "常量数据读取器配置",
      "properties": {
        "content": {
          "type": [
            "string",
            "number",
            "boolean",
            "null",
            "array",
            "object"
          ],
          "description": "常量数据"
        }
      },
      "required": [
        "content"
      ],
      "constantReader": {
        "$id": "#aiReader",
        "type": "object",
        "description": "AI数据生成器配置",
        "properties": {
          "provider": {
            "type": "string",
            "description": "AI提供商枚举",
            "enum": [
              "OLLAMA"
            ]
          },
          "model": {
            "type": "string",
            "description": "模型名称"
          },
          "template": {
            "type": "string",
            "description": "提示词模板"
          },
          "parser": {
            "type": "string",
            "description": "响应结果解析类"
          },
          "subject": {
            "type": "string",
            "description": "问题主题"
          }
        },
        "required": [
          "subject"
        ]
      }
    }
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example.gensokyo</groupId>
    <artifactId>template-v2-pf4j-plugin-sample</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <pf4j.version>3.15.0</pf4j.version>
        <data.generator.version>3.0.0-SNAPSHOT</data.generator.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.gensokyo.data.generator</groupId>
            <artifactId>data-generator-calcite</artifactId>
            <version>${data.generator.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.gensokyo.data.generator</groupId>
            <artifactId>data-generator-core</artifactId>
            <version>${data.generator.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.pf4j</groupId>
            <artifactId>pf4j</artifactId>
            <version>${pf4j.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

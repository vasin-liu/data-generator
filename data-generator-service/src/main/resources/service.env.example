# Data Generator packaged runtime configuration
# Copy this file to conf/service.env and customize for your environment.
#
# All paths may be absolute or relative to the package root (parent of bin/).

# --- Java runtime (JDK 25 required) ---
# DG_JAVA_HOME=/opt/jdk-25
# DG_JAVA_MIN_VERSION=25

# --- Service identity ---
DG_SERVICE_NAME=data-generator-service
# coordinator = main API node (default), worker = distributed worker process
DG_SERVICE_ROLE=coordinator
# Worker process name (used by bin/run-worker.sh when DG_SERVICE_NAME is unset there)
# DG_WORKER_SERVICE_NAME=data-generator-worker
# Used only when DG_SERVICE_ROLE=worker
DG_MAIN_CLASS=org.gensokyo.data.DataGeneratorWorkerApplication

# --- Network ---
DG_SERVER_PORT=9876
# Override full health URL (default: http://127.0.0.1:${DG_SERVER_PORT}/healthz)
# DG_HEALTH_URL=http://127.0.0.1:9876/healthz

# --- Spring Boot ---
# Leave empty to use application.yaml defaults
# DG_SPRING_PROFILES_ACTIVE=
# Extra args appended to the java command (space-separated)
# DG_SPRING_ARGS=

# --- JVM (daemon / background mode) ---
DG_HEAP_MIN=512m
DG_HEAP_MAX=1g
# Extra JVM flags (e.g. -Dfile.encoding=UTF-8)
# DG_JVM_OPTS=

# --- Logging & paths ---
# DG_LOG_DIR=../logs
# DG_LOG_FILE=../logs/data-generator-service.log
# DG_PID_FILE=../data-generator-service.pid
# DG_JVMDUMP_DIR=../jvmdump

# --- Process control ---
# Seconds to wait after background start before returning
DG_START_WAIT_SEC=5
# Graceful stop timeout before SIGKILL
DG_STOP_TIMEOUT_SEC=30
# 1 = background (default), 0 = foreground
# DG_DAEMON=1
# Allow interactive JDK path prompt on TTY (not for systemd/cron)
# DG_JAVA_PROMPT=0

# --- Keepalive (keepalive.sh / keepalive.ps1) ---
# DG_KEEPALIVE_MAX_FAIL=3
# DG_KEEPALIVE_CRON=*/5 * * * *
